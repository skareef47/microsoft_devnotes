# ==========================================
# ContextIQ Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL-compatible)
DATABASE_URL=sqlite:///./contextiq.db

# Authentication
# Secret used for signing JWT access tokens (generate using `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Memory: Self-Hosted Hindsight
# Self-hosted Hindsight API endpoint (default: http://localhost:8888 on host, http://hindsight:8888 in compose)
HINDSIGHT_BASE_URL=http://localhost:8888
# API Key is optional/empty for local self-hosted Hindsight
HINDSIGHT_API_KEY=
# Shared team memory bank ID (resolved server-side per team)
HINDSIGHT_BANK_ID=contextiq-team

# Internal LLM for Self-Hosted Hindsight
# Hindsight uses an internal LLM for fact extraction and memory consolidation
# Supported providers: gemini, openai, anthropic, groq, ollama
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_API_KEY=your_gemini_api_key_here
HINDSIGHT_API_LLM_MODEL=gemini-1.5-flash

# ContextIQ Application LLM Provider Configuration
# Supported providers: gemini, openai, anthropic, mock
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Frontend & Application Settings
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
