# ==========================================
# ContextIQ Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL-compatible)
DATABASE_URL=postgresql://contextiq:contextiq_dev_password@localhost:5432/contextiq_db

# Authentication
# Secret used for signing JWT access tokens (generate using `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Memory: Hindsight Cloud
# Frontend MUST NEVER access Hindsight directly.
# Hindsight API key obtained from Hindsight Cloud console
HINDSIGHT_API_KEY=your_hindsight_api_key_here
# Shared team memory bank ID (resolved server-side per team)
HINDSIGHT_BANK_ID=team_default_bank_id

# LLM Provider Configuration
# Supported providers: gemini, openai, anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash

# Frontend & Application Settings
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
